---
import EditLink from 'virtual:starlight/components/EditLink';
import Pagination from 'virtual:starlight/components/Pagination';
import { T, lang, base, VERSION, FECHA, WEB } from '../sitio';
const l = lang(Astro.currentLocale);
---

<footer>
	<Pagination />
	<div class="meta">
		<span>{T[l].actualizado(VERSION, FECHA[l])} · <a href={l === 'en' ? WEB + '/en/' : WEB + '/'}>opennccm.com</a> · <a href={base(l) + 'introduccion/novedades/'}>{T[l].novedades}</a> · <a href={l === 'en' ? WEB + '/en/changelog.html' : WEB + '/novedades.html'}>{l === 'en' ? 'Full changelog' : 'Historial completo'}</a></span>
		<EditLink />
	</div>
</footer>

<style>
	footer { display: flex; flex-direction: column; gap: 18px; margin-top: 2.5rem; }
	.meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; font-size: 12.5px; color: var(--sl-color-gray-3); }
	.meta :global(a) { color: var(--sl-color-text-accent); }
</style>
