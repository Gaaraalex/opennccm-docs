---
import EditLink from 'virtual:starlight/components/EditLink';
import Pagination from 'virtual:starlight/components/Pagination';
import { T, lang, VERSION, FECHA } from '../sitio';
const l = lang(Astro.currentLocale);
---

<footer>
	<Pagination />
	<div class="meta">
		<span>{T[l].actualizado(VERSION, FECHA[l])}</span>
		<EditLink />
	</div>
</footer>

<style>
	footer { display: flex; flex-direction: column; gap: 18px; margin-top: 2.5rem; }
	.meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; font-size: 12.5px; color: var(--sl-color-gray-3); }
	.meta :global(a) { color: var(--sl-color-text-accent); }
</style>
