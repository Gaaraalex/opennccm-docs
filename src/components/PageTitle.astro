---
const PAGE_TITLE_ID = '_top';
import { T, lang } from '../sitio';
import CursoVideo from './CursoVideo.astro';

const route = Astro.locals.starlightRoute;
const { title, description, curso, resumen } = route.entry.data as typeof route.entry.data & { curso?: string[]; resumen?: string[] };
const l = lang(Astro.currentLocale);
const t = T[l];

// Migas: el grupo del menú lateral que contiene la página actual.
type Item = { type: 'link' | 'group'; label: string; isCurrent?: boolean; entries?: Item[] };
const grupo = (route.sidebar as Item[]).find((g) => g.type === 'group' && g.entries?.some((e) => e.isCurrent));
const md = (l === 'en' ? '/en' : '') + '/md/' + (route.id.replace(/^en\/?/, '').replace(/^index$/, '') || 'inicio') + '.md';
---

<div class="cab-pagina" data-pagefind-ignore>
	<nav class="migas" aria-label={t.migas}>
		{grupo && <><span>{grupo.label}</span><span aria-hidden="true">›</span></>}
		<span class="actual">{title}</span>
	</nav>
	<div class="copiar" data-md={md}>
		<button type="button" class="b-copiar" data-accion="copiar">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3"/></svg>{t.copiar}
		</button>
		<button type="button" class="b-mas" aria-label={t.masOpciones} aria-expanded="false" aria-haspopup="menu">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
		</button>
		<div class="menu" role="menu" hidden>
			<button type="button" role="menuitem" data-accion="copiar"><b>{t.copiar}</b><small>{t.copiarSub}</small></button>
			<a role="menuitem" href={md} target="_blank" rel="noopener"><b>{t.verMd}</b><small>{t.verMdSub}</small></a>
			<button type="button" role="menuitem" data-accion="asistente"><b>{t.asistente}</b><small>{t.asistenteSub}</small></button>
		</div>
		<p class="aviso" role="status" data-ok={t.copiada} data-asistente={t.copiadaAsistente}></p>
	</div>
</div>
<h1 id={PAGE_TITLE_ID}>{title}</h1>
{description && <p class="subtitulo">{description}</p>}
{curso && <CursoVideo lecciones={curso} />}
{resumen && (
	<aside class="en-resumen" aria-label={t.enResumen}>
		<p class="en-resumen-tit">{t.enResumen}</p>
		<ul>{resumen.map((x) => <li>{x}</li>)}</ul>
	</aside>
)}

<script>
	document.querySelectorAll<HTMLElement>('.copiar').forEach((c) => {
		const menu = c.querySelector<HTMLElement>('.menu')!;
		const mas = c.querySelector<HTMLButtonElement>('.b-mas')!;
		const aviso = c.querySelector<HTMLElement>('.aviso')!;
		const cerrar = () => { menu.hidden = true; mas.setAttribute('aria-expanded', 'false'); };
		mas.addEventListener('click', (e) => { e.stopPropagation(); menu.hidden = !menu.hidden; mas.setAttribute('aria-expanded', String(!menu.hidden)); });
		document.addEventListener('click', (e) => { if (!c.contains(e.target as Node)) cerrar(); });
		document.addEventListener('keydown', (e) => { if (e.key === 'Escape') cerrar(); });
		let t: number;
		c.querySelectorAll<HTMLButtonElement>('[data-accion]').forEach((b) =>
			b.addEventListener('click', async () => {
				cerrar();
				try {
					const texto = await (await fetch(c.dataset.md!)).text();
					await navigator.clipboard.writeText(texto);
					aviso.textContent = b.dataset.accion === 'asistente' ? aviso.dataset.asistente! : aviso.dataset.ok!;
				} catch { aviso.textContent = ''; window.open(c.dataset.md, '_blank'); }
				clearTimeout(t); t = window.setTimeout(() => (aviso.textContent = ''), 4000);
			}),
		);
	});
</script>

<style>
	.cab-pagina { display: flex; align-items: center; gap: 12px; margin-top: 0.5rem; }
	.migas { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 12.5px; color: var(--sl-color-gray-3); flex: 1; min-width: 0; }
	.migas .actual { color: var(--sl-color-gray-2); }
	.copiar { position: relative; display: inline-flex; flex: none; }
	.copiar > button { display: inline-flex; align-items: center; gap: 8px; height: 34px; padding: 0 12px; border: 1px solid var(--sl-color-hairline);
		background: var(--sl-color-bg); color: var(--sl-color-gray-2); font: 500 13px var(--sl-font); cursor: pointer; }
	.copiar > button:hover { border-color: var(--sl-color-accent); color: var(--sl-color-white); }
	.b-copiar { border-radius: 9px 0 0 9px; }
	.b-mas { border-radius: 0 9px 9px 0; margin-left: -1px; width: 34px; justify-content: center; padding: 0 !important; }
	.copiar svg { width: 14px; height: 14px; }
	.menu { position: absolute; right: 0; top: 40px; z-index: 20; width: 290px; padding: 6px; border-radius: 12px;
		border: 1px solid var(--sl-color-hairline); background: var(--sl-color-bg-nav); box-shadow: var(--sl-shadow-md); }
	.menu[hidden] { display: none; }
	.menu > * { display: block; width: 100%; padding: 9px 10px; border: 0; border-radius: 8px; background: transparent; text-align: left;
		color: var(--sl-color-gray-2); text-decoration: none; cursor: pointer; font: inherit; }
	.menu > *:hover { background: var(--sl-color-accent-low); }
	.menu b { display: block; font: 500 13px var(--sl-font); color: var(--sl-color-white); }
	.menu small { display: block; font-size: 11.5px; color: var(--sl-color-gray-3); }
	.aviso { position: fixed; left: 50%; bottom: 28px; transform: translateX(-50%); z-index: 50; margin: 0; padding: 10px 16px; border-radius: 10px;
		background: var(--sl-color-white); color: var(--sl-color-black); font: 500 13px var(--sl-font); max-width: calc(100vw - 32px); }
	.aviso:empty { display: none; }
	h1 { margin-top: 0.9rem; font: 700 var(--sl-text-h1)/1.15 var(--fuente-titulo); color: var(--sl-color-white); }
	.subtitulo { margin: 0.6rem 0 0; font-size: 1.0625rem; color: var(--sl-color-gray-3); }
	@media (max-width: 40rem) { .b-copiar { font-size: 0 !important; gap: 0 !important; width: 34px; justify-content: center; padding: 0 !important; } }
</style>
