---
import { T, lang } from '../sitio';
const t = T[lang(Astro.currentLocale)];
---

<button type="button" class="tema" aria-label={t.tema} title={t.tema}>
	<svg class="sol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
	<svg class="luna" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
</button>

<script>
	document.querySelectorAll<HTMLButtonElement>('button.tema').forEach((b) =>
		b.addEventListener('click', () => {
			const nuevo = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
			document.documentElement.dataset.theme = nuevo;
			try { localStorage.setItem('starlight-theme', nuevo); } catch {}
		}),
	);
</script>

<style>
	.tema { display: inline-grid; place-items: center; width: 34px; height: 34px; border-radius: 9px; border: 1px solid var(--sl-color-hairline);
		background: transparent; color: var(--sl-color-gray-2); cursor: pointer; }
	.tema:hover { border-color: var(--sl-color-accent); color: var(--sl-color-white); }
	.tema svg { width: 16px; height: 16px; }
	/* En oscuro se ofrece el sol (pasar a claro) y al revés. */
	:global([data-theme='light']) .sol, :global([data-theme='dark']) .luna { display: none; }
</style>
