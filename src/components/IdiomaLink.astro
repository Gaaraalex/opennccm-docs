---
import { T, lang } from '../sitio';
const l = lang(Astro.currentLocale);
const t = T[l];
// La misma página en el otro idioma: /x/ ↔ /en/x/
const p = Astro.url.pathname;
const otra = l === 'en' ? p.replace(/^\/en(\/|$)/, '/') : '/en' + p;
---

<a class="idioma" href={otra} hreflang={l === 'en' ? 'es' : 'en'} lang={l === 'en' ? 'es' : 'en'} title={t.otroIdiomaNombre}>{t.otroIdioma}</a>

<style>
	.idioma { display: inline-grid; place-items: center; min-width: 34px; height: 34px; padding: 0 8px; border-radius: 9px; border: 1px solid var(--sl-color-hairline);
		color: var(--sl-color-gray-2); font: 600 12.5px var(--sl-font); text-decoration: none; }
	.idioma:hover { border-color: var(--sl-color-accent); color: var(--sl-color-white); }
</style>
