---
import { T, lang } from '../sitio';
const { siteTitleHref } = Astro.locals.starlightRoute;
const t = T[lang(Astro.currentLocale)];
---

<a href={siteTitleHref} class="marca" translate="no">
	<img src="/favicon.svg" alt="" width="28" height="28" />
	<b>Open<span>NCCM</span></b>
	<small>{t.docs}</small>
</a>

<style>
	.marca { display: flex; align-items: center; gap: 10px; text-decoration: none; white-space: nowrap; }
	.marca b { font: 800 19px/1 var(--fuente-titulo); color: var(--sl-color-white); }
	.marca b span { color: var(--marca-lima-texto); }
	.marca small { font: 600 12px/1 var(--sl-font); color: var(--sl-color-gray-3); border: 1px solid var(--sl-color-hairline); border-radius: 6px; padding: 3px 7px; }
</style>
